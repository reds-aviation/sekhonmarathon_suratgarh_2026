# Choose the target explicitly for local previews. The build scripts set this
# from their mode: `pages` for GitHub Pages and `app` for Netlify.
VITE_BUILD_TARGET=app

# GitHub Pages public-guide target. Keep this URL aligned with the repository
# path; it is used for canonical metadata and public asset links.
VITE_PAGES_BASE_PATH=/sekhonmarathon_suratgarh_2026/
VITE_PAGES_URL=https://reds-aviation.github.io/sekhonmarathon_suratgarh_2026/

# Authenticated Netlify app target. Configure the deployed Netlify origin here
# and allow this redirect URL in Supabase Auth before a trusted release.
VITE_APP_BASE_PATH=/
VITE_APP_URL=http://localhost:3000/
VITE_AUTH_REDIRECT_URL=http://localhost:3000/

# Browser-safe Supabase configuration for the authenticated app only. Never put
# a service-role key or any deployment token in a VITE_ or NEXT_PUBLIC_ value.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets are configured in the Supabase project, not in
# the browser build. SITE_ORIGIN must be one exact HTTPS Netlify origin with no
# path, query, fragment, credentials or wildcard; it must match the deployed
# VITE_APP_URL origin. Keep the Drive mirror HMAC secret and service-role key
# out of .env.local, source control and every VITE_ variable.
# SITE_ORIGIN=https://your-final-app.netlify.app
# DRIVE_MIRROR_HMAC_SECRET=configure-in-supabase-and-private-apps-script-only
